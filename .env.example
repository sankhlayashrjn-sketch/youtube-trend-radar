YOUTUBE_API_KEY=your-youtube-data-api-v3-key
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=your-resend-api-key
# Supabase Transaction pooler string (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Optional: session pooler (port 5432), used only by drizzle-kit if 6543 fails
MIGRATION_URL=
CRON_SECRET=generate-with-openssl-rand-hex-32
EMAIL_FROM=Trend Radar <onboarding@resend.dev>
# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Default recipient (Resend free sender can only email your own signup address)
EMAIL_TO=you@example.com
# Public base URL used in emails (optional)
APP_URL=
